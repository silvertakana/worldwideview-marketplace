# Copy to .env.local and fill in real values.

# Ed25519 JWK used to sign short-lived engine tokens (matches /api/auth/jwks)
MARKETPLACE_JWK_PRIVATE=

# SQLite database URL
DATABASE_URL=file:./prisma/registry.db

# Admin password for protected admin routes
ADMIN_PASSWORD=

# Marketplace registry private key (Ed25519)
REGISTRY_PRIVATE_KEY=

# Supabase — shared session cookie (ADR-003D)
# Copy from worldwideview-web .env.local
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>
# Cookie domain: .wwv.local in dev, .worldwideview.dev in production
NEXT_PUBLIC_WWV_COOKIE_DOMAIN=.wwv.local
# Auth host: where users are sent to log in
NEXT_PUBLIC_AUTH_HOST_URL=https://wwv.local

# Internal service-to-service secret (shared with worldwideview-web)
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Must match MARKETPLACE_INTERNAL_SECRET in worldwideview-web/.env.local
MARKETPLACE_INTERNAL_SECRET=

# URL overrides for local dev (point to local hub)
NEXT_PUBLIC_DOCS_URL=http://wwv.local:3001/docs
NEXT_PUBLIC_LEGAL_URL=http://wwv.local:3001/legal
# Set to empty to disable analytics locally
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
# JWT issuer for engine tokens
JWT_ISSUER=http://marketplace.wwv.local:3002

# Webhook fired when a plugin is submitted (optional)
# Leave SUBMIT_WEBHOOK_URL blank to disable entirely.
# If SUBMIT_WEBHOOK_SECRET is set it is forwarded as X-WWV-Webhook-Secret so
# the recipient can verify origin.
SUBMIT_WEBHOOK_URL=
SUBMIT_WEBHOOK_SECRET=

# ============================================================
# Stripe Billing
# ============================================================

# Stripe Secret API Key — used server-side for all Stripe API calls
# Get from Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=

# Stripe Webhook Signing Secret — used to verify webhook event signatures
# Get from Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> "Signing secret"
STRIPE_WEBHOOK_SECRET=

# Stripe Pro Plan Price ID — the price ID for the monthly pro plan
# Create the price in Stripe Dashboard -> Products, then copy the price ID
STRIPE_PRO_PRICE_ID=

# Stripe Publishable Key — safe to expose in browser bundles
# Used by Stripe Elements / Stripe.js on the client side
# Get from Stripe Dashboard -> Developers -> API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Provisioning API Key — internal service-to-service secret for proxy calls to worldwideview
# Must match PROVISIONING_API_KEY in worldwideview/.env.local
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PROVISIONING_API_KEY=
