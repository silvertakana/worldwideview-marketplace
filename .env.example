# Copy to .env.local and fill in real values.

# Ed25519 JWK used to sign short-lived engine tokens (matches /api/auth/jwks)
MARKETPLACE_JWK_PRIVATE=

# SQLite database URL
DATABASE_URL=file:./prisma/registry.db

# Admin password for protected admin routes
ADMIN_PASSWORD=

# Marketplace registry private key (Ed25519)
REGISTRY_PRIVATE_KEY=

# Supabase — shared session cookie (ADR-003D)
# Copy from worldwideview-web .env.local
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>
# Cookie domain: .wwv.local in dev, .worldwideview.dev in production
NEXT_PUBLIC_WWV_COOKIE_DOMAIN=.wwv.local
# Auth host: where users are sent to log in
NEXT_PUBLIC_AUTH_HOST_URL=https://wwv.local

# Internal service-to-service secret (shared with worldwideview-web)
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Must match MARKETPLACE_INTERNAL_SECRET in worldwideview-web/.env.local
MARKETPLACE_INTERNAL_SECRET=
