generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Plugin {
  id              String          @id // (e.g., "aviation" or "my-custom-plugin")
  npmPackage      String          @unique
  icon            String          // lucide-react icon name e.g. "Plane"
  category        String
  format          String          // "bundle" | "static" | "dynamic"
  trust           String          @default("pending") // "built-in", "verified", "unverified", "pending"
  capabilities    String          // JSON string array of capabilities
  longDescription String
  changelog       String?
  addedAt         DateTime        @default(now())
  installs        Int             @default(0)
  pluginInstalls  PluginInstall[]
}

model PluginInstall {
  id            String   @id @default(cuid())
  userId        String
  pluginId      String
  pluginSlug    String
  pluginVersion String
  instanceUrl   String
  installedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plugin        Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([userId, pluginId])
  @@index([userId, installedAt])
  @@map("plugin_installs")
}

model User {
  id              String                   @id @default(cuid())
  supabaseUserId  String?                  @unique
  email           String                   @unique
  createdAt       DateTime                 @default(now())
  apiKeys         MarketplaceApiKey[]
  oauthCodes      OAuthAuthorizationCode[]
  linkedInstances LinkedInstance[]
  pluginInstalls  PluginInstall[]
}

/// A WWV instance URL this user has installed plugins to. Persisted server-side
/// so the install flow auto-detects the right target on new devices / fresh
/// sessions (rather than asking the user to retype it every time).
model LinkedInstance {
  id         String   @id @default(cuid())
  userId     String
  url        String // Normalised origin, e.g. "https://wwv.local:3000"
  nickname   String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, url])
  @@index([userId, lastUsedAt])
  @@map("linked_instances")
}

model OAuthAuthorizationCode {
  code                String   @id
  codeChallenge       String
  codeChallengeMethod String
  clientId            String
  redirectUri         String
  scope               String
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  @@index([expiresAt])
  @@map("oauth_authorization_codes")
}

model MarketplaceApiKey {
  id         String    @id @default(cuid())
  userId     String
  keyHash    String    @unique
  deviceId   String?
  name       String?
  origin     String? // Normalised origin the key was issued for, e.g. "https://myglobe.com" (null for wwv:// loopback)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([origin])
}

model SigningKey {
  id         String    @id @default(cuid())
  kid        String    @unique
  privateJwk String
  publicJwk  String
  status     String    @default("active") // "active" | "retiring" | "revoked"
  createdAt  DateTime  @default(now())
  retiredAt  DateTime?
  revokedAt  DateTime?

  @@index([status])
}

model NpmCache {
  npmPackage  String   @id // The npm package name, acting as PK
  name        String
  description String
  version     String
  author      String
  keywords    String   // JSON string array of keywords
  repository  String?
  readme      String?
  changelog   String?
  updatedAt   String   // e.g. "YYYY-MM-DD"
  crawledAt   DateTime @default(now())
}
