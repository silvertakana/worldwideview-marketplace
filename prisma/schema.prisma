generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Plugin {
  id              String   @id // (e.g., "aviation" or "my-custom-plugin")
  npmPackage      String   @unique
  icon            String   // lucide-react icon name e.g. "Plane"
  category        String
  format          String   // "bundle" | "static" | "dynamic"
  trust           String   @default("pending") // "built-in", "verified", "unverified", "pending"
  capabilities    String   // JSON string array of capabilities
  longDescription String
  changelog       String?
  addedAt         DateTime @default(now())
}

model User {
  id        String              @id @default(cuid())
  email     String              @unique
  tier      String              @default("free")
  createdAt DateTime            @default(now())
  apiKeys   MarketplaceApiKey[]
}

model MarketplaceApiKey {
  id         String    @id @default(cuid())
  userId     String
  keyHash    String    @unique
  deviceId   String?
  name       String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model NpmCache {
  npmPackage  String   @id // The npm package name, acting as PK
  name        String
  description String
  version     String
  author      String
  keywords    String   // JSON string array of keywords
  repository  String?
  readme      String?
  changelog   String?
  updatedAt   String   // e.g. "YYYY-MM-DD"
  crawledAt   DateTime @default(now())
}
