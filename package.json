{
  "name": "worldwideview-marketplace",
  "version": "1.16.2",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "private": true,
  "description": "Marketplace for WorldWideView plugins — browse, publish, and install data sources",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca next dev --webpack --port 3002 --hostname marketplace.wwv.local --experimental-https --experimental-https-key ./certs/marketplace.wwv.local-key.pem --experimental-https-cert ./certs/marketplace.wwv.local.pem",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:urls": "node scripts/lint-urls.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "better-sqlite3": "^13.0.3",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@size-limit/preset-app": "^12.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-security": "^4.0.1",
    "size-limit": "^12.1.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "path": ".next/static/chunks/**",
      "limit": "2 MB"
    }
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "better-sqlite3",
      "prisma",
      "sharp",
      "unrs-resolver",
      "@unrs/resolver-binding-linux-x64-gnu",
      "@unrs/resolver-binding-linux-x64-musl"
    ],
    "overrides": {
      "@puppeteer/browsers": "3.2.0",
      "brace-expansion@<2": "^1.1.18",
      "brace-expansion@>=4": "^5.0.9",
      "defu": ">=6.1.5",
      "deepmerge-ts": "^8.0.0",
      "fast-uri": "^3.1.5",
      "hono": "4.12.25",
      "js-yaml": "^4.3.0",
      "nanoid@<4": "3.3.18",
      "nanoid@>=4": "5.1.16",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0",
      "vite": "8.0.16"
    }
  }
}
