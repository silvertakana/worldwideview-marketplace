{
  "name": "worldwideview-marketplace",
  "version": "1.15.4",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "private": true,
  "description": "Marketplace for WorldWideView plugins — browse, publish, and install data sources",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca next dev --webpack --port 3002 --hostname marketplace.wwv.local --experimental-https --experimental-https-key ./certs/marketplace.wwv.local-key.pem --experimental-https-cert ./certs/marketplace.wwv.local.pem",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:urls": "node scripts/lint-urls.mjs",
    "docker:test": "docker build -t marketplace-test . && docker run --rm marketplace-test"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "2.105.3",
    "better-sqlite3": "^12.8.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.577.0",
    "next": "16.2.11",
    "prisma": "^7.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^22.2.1"
  },
  "devDependencies": {
    "@size-limit/preset-app": "^12.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-security": "^4.0.1",
    "size-limit": "^12.1.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "size-limit": [
    {
      "path": ".next/static/chunks/**",
      "limit": "2 MB"
    }
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "better-sqlite3",
      "prisma",
      "sharp",
      "unrs-resolver",
      "@unrs/resolver-binding-linux-x64-gnu",
      "@unrs/resolver-binding-linux-x64-musl"
    ],
    "overrides": {
      "brace-expansion@<2": "^1.1.18",
      "brace-expansion@>=4": "^5.0.9",
      "defu": ">=6.1.5",
      "fast-uri": "^3.1.5",
      "hono": "4.12.25",
      "js-yaml": "^4.3.0",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0",
      "vite": "8.0.16"
    }
  }
}
